{
  "manifest_version": 3,
  "name": "YTM Lyrics+",
  "version": "1.3.0",
  "description": "Karaoke-style lyrics for YouTube Music & YouTube — word-by-word sync, click-to-seek, fullscreen, offline cache. Zero configuration.",
  "icons": {
    "16": "icons/ytm-lyrics-16.png",
    "48": "icons/ytm-lyrics-48.png",
    "128": "icons/ytm-lyrics-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YTM Lyrics+",
    "default_icon": {
      "16": "icons/ytm-lyrics-16.png",
      "48": "icons/ytm-lyrics-48.png",
      "128": "icons/ytm-lyrics-128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["player-bridge.js"],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://lrclib.net/*", "https://api.lrc.cx/*"]
}
